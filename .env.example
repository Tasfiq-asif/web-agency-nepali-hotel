# Database — LOCAL Postgres for development.
#
# Bring it up with `docker compose up -d db` (publishes host port 5437).
# Production is Neon and is configured only in the Vercel dashboard — a Neon
# URL does not belong in this file or in .env.local.
#
# Put exactly ONE DATABASE_URL in .env.local. A second entry later in the file
# silently wins, because dotenv keeps the last value. That is not hypothetical:
# .env.local carried a local URL on line 2 and a Neon URL on line 23 from
# May 2026 until 2026-09-07, so every "local" run wrote to the production
# database, and it was found only when test bookings appeared in production.
DATABASE_URL=postgresql://mountain_user:[password]@localhost:5437/mountain_nest

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# BetterAuth secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-secret-here

# Resend (email) — get from resend.com
RESEND_API_KEY=re_xxxxxx
RESEND_FROM_EMAIL=bookings@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# Uploadthing (image uploads) — get from uploadthing.com
UPLOADTHING_SECRET=sk_live_xxxxxx
UPLOADTHING_APP_ID=xxxxxx
