# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no secrets and is the only place the
# required shape of .env.local is written down. It was ignored and untracked
# until 2026-09-08, so a fresh clone had no guidance at all — which is part of
# how .env.local came to hold two DATABASE_URL entries.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# next-sitemap generated files (regenerated at build time via postbuild)
/public/sitemap.xml
/public/sitemap-0.xml
/public/sitemap*.xml
/public/robots.txt

# playwright mcp session artifacts (screenshots, console logs, snapshots)
.playwright-mcp/
